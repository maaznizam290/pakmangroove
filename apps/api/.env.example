# Copy to .env and fill in real values. Never commit the filled-in file.

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mangrove_ai

# --- Google Earth Engine (leave unset to run gee_client in credential-gated,
# no-live-call mode — see mangrove_ai/gee_client.py) ---
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=
GEE_PROJECT=

# Confirm the real CGMD-AFCC30 asset id before setting this — do not assume
# "CGMD-AFCC305" exists (see mangrove_ai/config.py).
CGMD_EXTENT_ASSET_ID=projects/mangrovedatahub2_assets/CGMD-Extent30SO
CGMD_AFCC_ASSET_ID=

# --- RAG backend: "ragflow" or "pgvector_fallback" (default) ---
RAG_BACKEND=pgvector_fallback
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_KB_NAME=Mangrove_AI_Knowledge

# --- Hermes / LLM-driven planning (omit to run the rule-based planner) ---
ANTHROPIC_API_KEY=
HERMES_MODEL=claude-sonnet-5

# --- Suitability model tuning ---
ECOLOGICAL_RISK_PROXIMITY_M=500.0
GRID_CELL_SIZE_M=30.0
