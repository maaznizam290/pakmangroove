# PakMang AI overrides for the vendored RAGFlow docker-compose stack.
# Copy to .env.pakmang and fill in real values. NEVER commit the filled-in file.
#
# Usage (on a machine with normal internet access — NOT the Claude Code
# cloud sandbox, which blocks Docker Hub image pulls):
#   cd infra/ragflow/vendor
#   docker compose --env-file ../.env.pakmang -f .env -f docker-compose.yml \
#     --profile cpu up -d

# --- Change every default credential before any non-local deployment ---
MYSQL_PASSWORD=CHANGE_ME
MINIO_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# elasticsearch (heavier, default) or infinity (lighter, single-binary)
DOC_ENGINE=infinity

# Exposed ports — keep default unless colliding with something else locally
SVR_WEB_HTTP_PORT=8080
SVR_HTTP_PORT=9380

RAGFLOW_IMAGE=infiniflow/ragflow:v0.27.2

# --- Consumed by apps/api (mangrove_ai.rag.ragflow_client) ---
# Generate this in the RAGFlow web UI: User settings -> API -> API Key,
# after first login (default admin bootstrap is documented in vendor/README.md).
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=CHANGE_ME
RAGFLOW_KB_NAME=Mangrove_AI_Knowledge
